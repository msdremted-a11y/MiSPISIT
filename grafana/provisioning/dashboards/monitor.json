      "title": "Последние снимки",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "app"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT id AS \"№\", taken_at AS \"Время\", author AS \"Кто снял\", CASE source WHEN 'proc' THEN 'из /proc' ELSE 'вручную' END AS \"Источник\", cpu_percent AS \"CPU, %\", io_latency_ms AS \"Задержка IO, мс\", iops AS \"IOPS\" FROM snapshot ORDER BY taken_at DESC, id DESC LIMIT 20"
        }
