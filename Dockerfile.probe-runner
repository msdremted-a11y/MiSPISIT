# probe-runner — исполнитель eBPF-пробников (курсовая).
# Тот же модуль Go, отдельный бинарник; в образе должен быть bpftrace.

# ---------- Этап 1: сборка ----------
FROM --platform=$BUILDPLATFORM golang:1.23-alpine AS builder
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags="-s -w" -o /out/probe-runner ./cmd/probe-runner

# ---------- Этап 2: запуск ----------
# bpftrace из пакетов Alpine; BTF ядра проверяется при запуске скрипта.
FROM alpine:3.20
RUN apk add --no-cache bpftrace
COPY --from=builder /out/probe-runner /usr/local/bin/probe-runner
CMD ["probe-runner"]
